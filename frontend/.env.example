# Public application origin used for canonical metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FastAPI origin used by the Next.js BFF. Prefer API_URL in production so the
# backend origin is not exposed to browser bundles.
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
